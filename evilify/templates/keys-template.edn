 ;; :normal {"SPC b p" :pin         ; bind a chord to a command
 ;;          "g s"     nil          ; unbind a built-in chord
 ;;          "SPC q"   "session"}   ; rename a which-key prefix group
 ;; :insert {"M-x"     :m-x}        ; keep M-x reachable while typing
